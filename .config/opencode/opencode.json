{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "engram": {
      "command": ["engram", "mcp", "--tools=agent"],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "read": { "**/.op.env": "allow" },
    "edit": { "**/.op.env": "allow" },
    "external_directory": { "~/Source/**": "allow" }
  },
  "plugin": ["superpowers@git+https://github.com/atkinchris/superpowers.git", "opencode-agent-memory@latest"],
  "skills": {
    "paths": ["~/Source/skills"]
  }
}
