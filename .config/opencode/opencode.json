{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "eu-west-1",
        "profile": "default"
      },
      "whitelist": [
        "eu.anthropic.claude-sonnet-5",
        "eu.anthropic.claude-sonnet-5-5",
        "eu.anthropic.claude-opus-5",
        "eu.anthropic.claude-opus-5-5"
      ]
    }
  },
  "permission": {
    "read": { "*.op.env": "allow" },
    "edit": { "*.op.env": "allow" },
    "external_directory": { "~/Source/**": "allow", "/tmp/**": "allow" }
  },
  "skills": {
    "paths": ["~/Source/skills"]
  }
}
