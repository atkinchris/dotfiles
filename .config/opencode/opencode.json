{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "providers": {
    "amazon-bedrock": {
      "settings": {
        "region": "eu-west-1",
        "profile": "default"
      }
    }
  },
  "permissions": [
    { "action": "read", "resource": "*.op.env", "effect": "allow" },
    { "action": "edit", "resource": "*.op.env", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Source/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" }
  ]
}
