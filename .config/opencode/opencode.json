{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "eu-west-1",
        "profile": "default"
      },
      "whitelist": ["eu.amazon.nova-micro-v1:0", "eu.amazon.nova-lite-v1:0", "eu.amazon.nova-pro-v1:0"]
    }
  },
  "permission": {
    "read": { "**/.op.env": "allow" },
    "edit": { "**/.op.env": "allow" },
    "external_directory": { "~/Source/**": "allow", "/tmp/**": "allow" }
  },
  "skills": {
    "paths": ["~/Source/skills"]
  }
}
